# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/coding_test_db

# Security
SECRET_KEY=your-secret-key-min-32-characters-long-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_EMAIL=admin@codingtest.local

# Test Configuration
DEFAULT_TEST_DURATION_MINUTES=120
EASY_QUESTIONS_PER_TEST=10
MEDIUM_QUESTIONS_PER_TEST=10
HARD_QUESTIONS_PER_TEST=5
EASY_MARKS=5
MEDIUM_MARKS=10
HARD_MARKS=20

# Code Execution (Piston API)
CODE_EXECUTION_API=https://emkc.org/api/v2/piston
CODE_EXECUTION_TIMEOUT_SECONDS=10

# Code Execution Method (local or piston)
# Set to true to use local compiler (faster, no rate limits, requires compilers installed)
# Set to false to use Piston API (cloud-based, no installation needed)
USE_LOCAL_COMPILER=false

# Grok API for AI Question Generation
GROK_API_KEY=your_groq_api_key_here

# Rate Limiting
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Application
ENVIRONMENT=development
DEBUG=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
