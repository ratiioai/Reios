# Copy to .env and fill in. Never commit .env.

# SQLite is fine for a single server; use PostgreSQL for large or multi-server deployments:
#   postgresql://user:password@host:5432/reios
DATABASE_URL=sqlite:///./coding_test.db

# At least 32 random characters. If left out, one is generated and kept in backend/.secret_key
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# The first super admin, created at startup if no super admin exists yet
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# Tuning for exam day (defaults shown)
# WORKER_THREADS=120
# BCRYPT_ROUNDS=10

ENVIRONMENT=development
DEBUG=false

# Optional: super admins sign in with Firebase Authentication instead of a password.
# Set to your Firebase project id and list the super admins' Firebase emails in SUPER_ADMIN_EMAIL.
# FIREBASE_PROJECT_ID=your-project-id

# Outgoing email for the 'Email results' add-on (any SMTP provider, e.g. Gmail app password, SendGrid, Brevo)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=Reios <you@gmail.com>
