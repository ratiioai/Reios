{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/backend.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
