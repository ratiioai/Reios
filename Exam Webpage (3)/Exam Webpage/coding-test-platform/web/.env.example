# Firebase web app config (Firebase console -> Project settings -> Your apps). Used only for super admin sign-in.
# These values are public by design; leave them empty to turn Firebase sign-in off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
