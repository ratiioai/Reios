# Reios laptop server settings. Keep this file private.
DATABASE_URL=postgresql+psycopg://reios:CHANGE_ME@127.0.0.1:5432/reios
SECRET_KEY=generate-a-long-random-string
ENVIRONMENT=production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
SUPER_ADMIN_EMAIL=you@example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
# Per API instance (4 instances x (10+5) = 60 of Postgres' 100 connections)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
WORKER_THREADS=60
API_INSTANCES=4
