# Reios laptop server settings. Keep this file private.
DATABASE_URL=postgresql+psycopg://reios:CHANGE_ME@127.0.0.1:5433/reios
SECRET_KEY=generate-a-long-random-string
ENVIRONMENT=production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
SUPER_ADMIN_EMAIL=you@example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
# Per API instance: 6 instances x (10+5) = 90 of Postgres' 200 connections; 12 threads each avoids Python lock pile-ups
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
WORKER_THREADS=12
API_INSTANCES=6
